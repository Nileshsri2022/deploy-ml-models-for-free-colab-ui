{
  "name": "colabdeploy-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ColabDeploy control UI: connect a Colab runtime, deploy any model, explore endpoints",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
